# Exemple de fichier .env (créé par pnpm db:setup).
# Note : le fichier doit s'appeler .env, pas .env.local, sans configuration supplémentaire.
#
# Cette liste ne contient que des variables réellement lues par le code.
# Toute variable ajoutée ici doit correspondre à un `process.env.*` existant.

# --- Base de données ---
# Seule POSTGRES_URL est lue (lib/db/drizzle.ts, drizzle.config.ts).
POSTGRES_URL=postgresql://***

# --- Application ---
# NEXT_PUBLIC_APP_URL sert à construire les liens du portail client, les URLs de
# retour GeniusPay et les payloads webhook. BASE_URL n'est utilisée que par le
# serveur OpenAPI et sert de repli.
NEXT_PUBLIC_APP_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# --- Paiements clients (Étape 3) ---
# Les identifiants marchands de chaque organisation ne sont PAS des variables
# d'environnement : ils vivent chiffrés en base (payment_gateway_credentials),
# enveloppés par la clé ci-dessous.
# Clé de chiffrement des credentials marchands : 64 caractères hex (32 octets).
# Obligatoire — sans elle, lib/payments/credentials.service.ts refuse de chiffrer.
PAYMENT_CREDENTIALS_KEK=***

# --- Billing SaaS : compte marchand Excellence (Étape 6) ---
# Distinct du GeniusPay des organisations : c'est Excellence qui encaisse
# les abonnements Free / Pro / Business.
EXCELLENCE_GENIUSPAY_API_KEY_PUBLIC=***
EXCELLENCE_GENIUSPAY_API_SECRET=***
EXCELLENCE_GENIUSPAY_WEBHOOK_SECRET=***
# sandbox | live (défaut : sandbox)
EXCELLENCE_GENIUSPAY_ENV=sandbox

# --- Stockage R2 (Étape 4) ---
R2_ACCOUNT_ID=***
R2_ACCESS_KEY_ID=***
R2_SECRET_ACCESS_KEY=***
R2_BUCKET_NAME=***

# --- Redis (rate limiting + idempotence des webhooks entrants) ---
# Optionnel en développement : repli en mémoire si absent.
UPSTASH_REDIS_REST_URL=https://***
UPSTASH_REDIS_REST_TOKEN=***

# --- n8n (Étape 5) ---
# L'URL et le secret HMAC de l'endpoint n8n ne sont PAS des variables d'env :
# ils vivent en base dans webhook_endpoints (url + secret), créés via l'API.
# Le secret généré là-bas doit être recopié dans la variable n8n
# N8N_EXCELLENCE_WEBHOOK_SECRET (voir n8n/README.md).

# --- Crons internes (/api/internal/cron/*) ---
# Secret partagé du worker de reprise des webhooks. À recopier dans la
# credential n8n « CONTRAVO_CRON_SECRET » (httpHeaderAuth :
# Authorization: Bearer <valeur>), utilisée par cron_webhook_retries_v1.
# Obligatoire : sans lui la route répond 401 et aucune reprise n'a lieu.
# Générer avec : openssl rand -base64 32
CRON_SECRET=***

# --- Déploiement des workflows n8n (n8n/scripts/deploy.ts) ---
N8N_API_BASE=https://n8n.example.app
N8N_API_KEY=***
# Optionnel : répertoire des workflows (défaut : n8n/workflows).
N8N_WORKFLOWS_DIR=n8n/workflows
