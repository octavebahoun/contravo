# Exemple de fichier .env (créé par pnpm db:setup).
# Note : le fichier doit s'appeler .env, pas .env.local, sans configuration supplémentaire.

# --- Base de données ---
POSTGRES_URL=postgresql://***
DATABASE_URL=postgresql://***

# --- Application ---
BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=***

# --- Paiements (Étape 3) ---
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
GENIUS_URL_ENDPOINT=https://***
GENIUS_SANDBOX_API_KEY=***
GENIUS_SANDBOX_SECRET_KEY=***
GENIUS_SANDBOX_WEBHOOK_SECRET=***
# Clé de chiffrement des credentials marchands : 64 caractères hex (32 octets)
PAYMENT_CREDENTIALS_KEK=***

# --- Stockage R2 (Étape 4) ---
R2_ACCOUNT_ID=***
R2_ACCESS_KEY_ID=***
R2_SECRET_ACCESS_KEY=***
R2_BUCKET_NAME=***
R2_PUBLIC_DOMAIN=***

# --- Redis (idempotence des webhooks entrants) ---
UPSTASH_REDIS_REST_URL=https://***
UPSTASH_REDIS_REST_TOKEN=***

# --- n8n (Étape 5) ---
# L'URL et le secret HMAC de l'endpoint n8n ne sont PAS des variables d'env :
# ils vivent en base dans webhook_endpoints (url + secret), créés via l'API.
# Le secret généré là-bas doit être recopié dans la variable n8n
# N8N_EXCELLENCE_WEBHOOK_SECRET (voir n8n/README.md).

# --- Déploiement des workflows n8n (scripts/deploy.ts) ---
N8N_API_BASE=https://n8n.example.app
N8N_API_KEY=***
