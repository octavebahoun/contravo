{
  "id": "healthcheck_v1",
  "name": "Healthcheck v1",
  "nodes": [
    {
      "id": "a7f532c8-8a70-4773-b212-5898f7ac8af3",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        100,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "f4593e79-e945-4350-a58e-f0341a17e71a",
      "name": "Call /api/v1/me",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        300,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.EXCELLENCE_API_BASE }}/api/v1/me",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Excellence-Environment",
              "value": "={{ $env.EXCELLENCE_ENV }}"
            }
          ]
        },
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "n8n_api_key",
          "name": "n8n API Key"
        }
      }
    },
    {
      "id": "0ecd2713-5250-4859-83f8-8fe98b615a4b",
      "name": "Track Failures",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\nlet failures = Number($workflow.staticData.failures || 0);\nconst ok = $('Call /api/v1/me').first().json?.statusCode === 200 || ($('Call /api/v1/me').first().json && Object.keys($('Call /api/v1/me').first().json).length > 0);\nif (ok) { failures = 0; } else { failures = failures + 1; }\n$workflow.staticData.failures = failures;\nreturn [{ json: { failures, alert: failures >= 3 } }];\n"
      }
    },
    {
      "id": "ceac9495-d23c-4058-b9b7-f4b775b5f984",
      "name": "Alert?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.alert }}",
              "operator": {
                "type": "boolean",
                "operation": "equals"
              },
              "rightValue": true
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "4f18933d-bf39-4ca7-ab23-09efad2f96f4",
      "name": "Alert Slack/Ops",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        900,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_ALERT_WEBHOOK }}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": {
          "text": "⚠️ n8n healthcheck: Excellence API unreachable 3× consecutively",
          "failures": "={{ $json.failures }}"
        }
      }
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Call /api/v1/me",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call /api/v1/me": {
      "main": [
        [
          {
            "node": "Track Failures",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Track Failures": {
      "main": [
        [
          {
            "node": "Alert?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert?": {
      "main": [
        [
          {
            "node": "Alert Slack/Ops",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}