{
  "id": "email_review_requested_v1",
  "name": "email_review_requested_v1",
  "nodes": [
    {
      "id": "9bfcbbae-82c9-4a68-9d4c-420e64cc809d",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        100,
        300
      ],
      "parameters": {
        "workflowInputs": {
          "values": []
        }
      }
    },
    {
      "id": "b542fa4a-e03f-4d10-a34a-5f6c227b67b4",
      "name": "Render Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const d=$('Execute Workflow Trigger').first().json.data||{};const c=d.client||{};return[{json:{to:c.email||d.recipientEmail,subject:'Votre avis nous intéresse',html:'<p>Bonjour '+(c.name||'')+',</p><p>Merci de donner votre avis sur la prestation.</p><p><a href=\"'+(d.portalUrl||'#')+'\">Laisser un avis</a></p>'}}];"
      }
    },
    {
      "id": "25d2a809-b0c8-472c-b924-74bfa529b8a3",
      "name": "Send via Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        500,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.RESEND_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": {
          "from": "={{ $env.RESEND_FROM }}",
          "to": [
            "={{ $json.to }}"
          ],
          "subject": "={{ $json.subject }}",
          "html": "={{ $json.html }}"
        }
      }
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Render Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Render Email": {
      "main": [
        [
          {
            "node": "Send via Resend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}