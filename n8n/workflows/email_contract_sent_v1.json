{
  "id": "email_contract_sent_v1",
  "name": "email_contract_sent_v1",
  "nodes": [
    {
      "id": "7aeaf08c-032f-4dcb-9671-8de8b1c7349a",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        100,
        300
      ],
      "parameters": {
        "workflowInputs": {
          "values": []
        }
      }
    },
    {
      "id": "f971a74d-6e30-41cb-8aae-2d6443c23830",
      "name": "Render Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const d=$('Execute Workflow Trigger').first().json.data||{};const c=d.client||{};return[{json:{to:c.email||d.recipientEmail,subject:'Contrat '+d.number+' à signer',html:'<p>Bonjour '+(c.name||'')+',</p><p>Veuillez signer le contrat <strong>'+d.number+'</strong>.</p><p><a href=\"'+(d.portalUrl||'#')+'\">Accéder au portail</a></p>',pdfDownloadUrl:d.pdfUrl||''}}];"
      }
    },
    {
      "id": "6536bb8c-2fa3-482d-8d59-d3d14ffaa8ff",
      "name": "Has PDF?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.pdfDownloadUrl }}",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "28608017-1162-43d4-8e0a-3283c318a36c",
      "name": "Fetch PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        700,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.pdfDownloadUrl }}",
        "options": {
          "response": {
            "responseFormat": "file",
            "outputPropertyName": "data"
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $env.EXCELLENCE_API_KEY }}"
            }
          ]
        }
      }
    },
    {
      "id": "5411141f-48a8-4b7b-abe3-ab38178b38e9",
      "name": "Send via Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        700,
        450
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.RESEND_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": {
          "from": "={{ $env.RESEND_FROM }}",
          "to": [
            "={{ $json.to }}"
          ],
          "subject": "={{ $json.subject }}",
          "html": "={{ $json.html }}"
        }
      }
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Render Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Render Email": {
      "main": [
        [
          {
            "node": "Has PDF?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has PDF?": {
      "main": [
        [
          {
            "node": "Fetch PDF",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send via Resend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch PDF": {
      "main": [
        [
          {
            "node": "Send via Resend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}