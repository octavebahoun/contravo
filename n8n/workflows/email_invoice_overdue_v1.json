{
  "id": "email_invoice_overdue_v1",
  "name": "email_invoice_overdue_v1",
  "nodes": [
    {
      "id": "f8ca6ca6-b672-4776-b7d5-520cdda11307",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        100,
        300
      ],
      "parameters": {
        "workflowInputs": {
          "values": []
        }
      }
    },
    {
      "id": "b2903143-b103-421f-b061-7ba811e76fd5",
      "name": "Render Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const d=$('Execute Workflow Trigger').first().json.data||{};const c=d.client||{};return[{json:{to:c.email||d.recipientEmail,subject:'Rappel — Facture '+d.number+' impayée',html:'<p>Bonjour '+(c.name||'')+',</p><p>La facture <strong>'+d.number+'</strong> est en retard de paiement.</p><p><a href=\"'+(d.portalUrl||'#')+'\">Régulariser</a></p>'}}];"
      }
    },
    {
      "id": "1aa90c93-34f9-4b24-a63d-52f2ba43eed8",
      "name": "Send via Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        500,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.RESEND_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": {
          "from": "={{ $env.RESEND_FROM }}",
          "to": [
            "={{ $json.to }}"
          ],
          "subject": "={{ $json.subject }}",
          "html": "={{ $json.html }}"
        }
      }
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Render Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Render Email": {
      "main": [
        [
          {
            "node": "Send via Resend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}