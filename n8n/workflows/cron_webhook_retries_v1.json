{
  "id": "cron_webhook_retries_v1",
  "name": "Cron — Webhook Retries v1",
  "nodes": [
    {
      "id": "5c1f8e02-7b4a-4f31-9c6d-2a1b3c4d5e6f",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [100, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "6d2a9f13-8c5b-4042-ad7e-3b2c4d5e6f70",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [280, 300],
      "notes": "Point unique de configuration. Modifier apiBase quand l'URL de deploiement change.",
      "notesInFlow": true,
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "7e3b0a24-9d6c-4153-be8f-4c3d5e6f7081",
              "name": "apiBase",
              "type": "string",
              "value": "https://contravo-7g6p.vercel.app"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "8f4c1b35-ae7d-4264-cf90-5d4e6f708192",
      "name": "Sweep Due Deliveries",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [500, 300],
      "notes": "Rejoue les livraisons dont le next_retry_at est echu et les 'pending' abandonnees. Le endpoint pose un bail sur les lignes qu'il reclame : deux executions concurrentes ne peuvent pas envoyer deux fois le meme webhook.",
      "notesInFlow": true,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBase }}/api/internal/cron/webhook-retries",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "CONTRAVO_CRON_SECRET"
        }
      }
    },
    {
      "id": "9a5d2c46-bf8e-4375-d0a1-6e5f70819203",
      "name": "Report Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300],
      "parameters": {
        "language": "javaScript",
        "jsCode": "// fullResponse + neverError : on juge sur le code HTTP, pas sur la forme du corps.\nconst res = $('Sweep Due Deliveries').first().json || {};\nconst code = res.statusCode || 0;\nconst body = res.body || {};\n\nif (code !== 200) {\n  // 401 = CONTRAVO_CRON_SECRET absent ou desynchronise de CRON_SECRET cote app.\n  throw new Error(`Webhook retry sweep failed: HTTP ${code} ${JSON.stringify(body).slice(0, 300)}`);\n}\n\nreturn [{ json: { ok: true, claimed: body.claimed ?? 0, dispatched: body.dispatched ?? 0, failures: body.failures ?? 0 } }];\n"
      }
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "Sweep Due Deliveries", "type": "main", "index": 0 }]]
    },
    "Sweep Due Deliveries": {
      "main": [[{ "node": "Report Outcome", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
