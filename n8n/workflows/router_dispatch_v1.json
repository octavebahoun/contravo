    {
      "id": "7953e26d-b3ad-44ff-83cf-d3b9de5e6d2e",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.apiBase }}/api/v1/webhooks/verify",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ signature: $json.headers['x-webhook-signature'], rawBody: JSON.stringify($json.body) }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "notes": "Le sandbox n8n interdit crypto/process.env dans les nodes Code : la verification HMAC est deleguee a Excellence.",
      "notesInFlow": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "EXCELLENCE_API_KEY"
        }
      }
