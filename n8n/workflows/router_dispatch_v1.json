    {
      "id": "0743be14-1c82-4c59-8df7-f9514c21fd41",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst crypto = require('crypto');\nconst secret = process.env.N8N_EXCELLENCE_WEBHOOK_SECRET;\nconst item = $('Excellence Events Webhook').first().json;\nconst header = item.headers['x-webhook-signature'];\nconst rawBody = JSON.stringify(item.body);\nconst parts = (header || '').split(',');\nlet ts, v1;\nfor (const p of parts) { const [k, v] = p.split('='); if (k === 't') ts = v; if (k === 'v1') v1 = v; }\nconst now = Math.floor(Date.now() / 1000);\nlet valid = false;\nif (ts && v1 && Math.abs(now - Number(ts)) <= 300) {\n  const expected = crypto.createHmac('sha256', secret).update(ts + '.' + rawBody).digest('hex');\n  valid = crypto.timingSafeEqual(Buffer.from(expected, 'hex'), Buffer.from(v1, 'hex'));\n}\nconst eventType = item.body?.type || item.headers['x-webhook-event'];\nreturn [{ json: { valid, event: eventType } }];\n"
      }
    },
