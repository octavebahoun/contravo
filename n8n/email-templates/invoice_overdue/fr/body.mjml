<mjml><mj-body><mj-section><mj-column><mj-text>Bonjour {{client.name}},</mj-text><mj-text>{{reminder.message}}</mj-text><mj-text>Facture <strong>{{number}}</strong> — reste à régler : <strong>{{amountDueLabel}}</strong>, échéance dépassée de {{daysOverdue}} jour(s).</mj-text><mj-button href="{{portalUrl}}">{{reminder.cta}}</mj-button><mj-text>{{reminder.closing}}</mj-text></mj-column></mj-section></mj-body></mjml>